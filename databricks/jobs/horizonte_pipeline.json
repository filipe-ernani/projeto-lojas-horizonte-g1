{
  "name": "horizonte_pipeline",
  "description": "Pipeline medalhão da Lojas Horizonte: bronze, silver, gold e qualidade, a partir do main do GitHub (issue #19, D26).",
  "git_source": {
    "git_url": "https://github.com/filipe-ernani/projeto-lojas-horizonte-g1",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "queue": {
    "enabled": true
  },
  "tags": {
    "projeto": "lojas-horizonte"
  },
  "tasks": [
    {
      "task_key": "00_setup",
      "notebook_task": {
        "notebook_path": "pipeline/00_setup",
        "source": "GIT"
      }
    },
    {
      "task_key": "01_bronze_olist",
      "notebook_task": {
        "notebook_path": "pipeline/01_bronze_olist",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "00_setup"
        }
      ]
    },
    {
      "task_key": "03_silver_olist",
      "notebook_task": {
        "notebook_path": "pipeline/03_silver_olist",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "01_bronze_olist"
        }
      ]
    },
    {
      "task_key": "06_bronze_erp",
      "notebook_task": {
        "notebook_path": "pipeline/06_bronze_erp",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "00_setup"
        }
      ]
    },
    {
      "task_key": "07_silver_erp",
      "notebook_task": {
        "notebook_path": "pipeline/07_silver_erp",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "06_bronze_erp"
        }
      ]
    },
    {
      "task_key": "08_bronze_site",
      "notebook_task": {
        "notebook_path": "pipeline/08_bronze_site",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "00_setup"
        }
      ]
    },
    {
      "task_key": "09_silver_site",
      "notebook_task": {
        "notebook_path": "pipeline/09_silver_site",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "08_bronze_site"
        }
      ]
    },
    {
      "task_key": "10_silver_unificada",
      "notebook_task": {
        "notebook_path": "pipeline/10_silver_unificada",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "03_silver_olist"
        },
        {
          "task_key": "07_silver_erp"
        },
        {
          "task_key": "09_silver_site"
        }
      ]
    },
    {
      "task_key": "11_gold",
      "notebook_task": {
        "notebook_path": "pipeline/11_gold",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "10_silver_unificada"
        }
      ]
    },
    {
      "task_key": "12_qualidade",
      "notebook_task": {
        "notebook_path": "pipeline/12_qualidade",
        "source": "GIT"
      },
      "depends_on": [
        {
          "task_key": "11_gold"
        }
      ]
    }
  ]
}
