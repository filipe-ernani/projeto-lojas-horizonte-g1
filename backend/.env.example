# Ambiente de execução (development ou production)
NODE_ENV=development

# Porta da API do back-end
PORT=3000

# Origens autorizadas no CORS, separadas por vírgula (Front-end Vite)
FRONT_ORIGIN=http://localhost:5173

# ID do Projeto no Firebase (somente projectId, sem arquivo de chave)
FIREBASE_PROJECT_ID=

# Tokens sintéticos test:/mock: para testes locais. Mantenha false; nunca valem em produção
ALLOW_TEST_TOKENS=false

# Valor fixo de frete simulado (D-27)
FRETE_SIMULADO=15.00

# Chave secreta de integração para ingestão de Dados e BI (cabeçalho X-API-Key)
INTEGRACAO_API_KEY=

# Agente de IA (Google ADK, adk api_server). URL base, sem caminho (ex.: http://127.0.0.1:8000)
ADK_URL=
# Nome do app no ADK (padrão agente_horizonte)
ADK_APP_NAME=agente_horizonte
# Tempo máximo de resposta do agente em milissegundos (padrão 60000)
ADK_TIMEOUT_MS=60000

# Configurações do PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=horizonte
POSTGRES_PORT=5432

# URL de conexão ao banco de dados pelo Pool do pg
DATABASE_URL=

# TLS do banco: false (local), true (valida o certificado) ou no-verify (não valida)
DATABASE_SSL=false
