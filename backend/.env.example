# Porta da API do back-end
PORT=3000

# Origem autorizada no CORS (Front-end Vite)
FRONT_ORIGIN=http://localhost:5173

# ID do Projeto no Firebase (somente projectId, sem arquivo de chave)
FIREBASE_PROJECT_ID=lojas-magazine

# Valor fixo de frete simulado (D-27)
FRETE_SIMULADO=15.00

# Chave secreta de integração para ingestão de Dados e BI (cabeçalho X-API-Key)
INTEGRACAO_API_KEY=sua-chave-secreta-de-integracao-aqui

# URL do endpoint de chat com IA no ADK (provisório com Emanuel)
ADK_URL=http://localhost:8000/chat

# Configurações do PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=horizonte
POSTGRES_PORT=5432

# URL de conexão ao banco de dados pelo Pool do pg
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/horizonte
