# Copie os valores de Connection Details do SQL warehouse. Não use https:// no hostname.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
# Token de acesso pessoal, somente se suportado pelo workspace. Nunca versionar .env.
DATABRICKS_TOKEN=

# Nome completo real: catalogo.schema.tabela. Colunas confirmadas: sku e categoria.
DATABRICKS_CATALOG_TABLE=
DATABRICKS_CATALOG_PRODUCT_ID_COLUMN=sku
DATABRICKS_CATALOG_CATEGORY_COLUMN=categoria

# Preencher juntos somente após a entrega dos reviews com vínculo inequívoco ao SKU.
DATABRICKS_REVIEWS_TABLE=
DATABRICKS_REVIEWS_PRODUCT_ID_COLUMN=

# Limites em segundos (1 a 300). Sem novas tentativas automáticas.
DATABRICKS_SOCKET_TIMEOUT_SECONDS=30
DATABRICKS_STATEMENT_TIMEOUT_SECONDS=60

# Quantidade padrão de resultados lexicais; inteiro positivo.
BM25_TOP_K=5

# Testes reais são opcionais e desativados por padrão.
RUN_DATABRICKS_INTEGRATION=0

# Agente ADK: chave do Google AI Studio (não usar Vertex AI).
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelo principal obrigatório. Use um único ID Gemini por variável.
GEMINI_MODEL=
# Modelos alternativos opcionais, usados nesta ordem. Deixe vazio para não usar.
GEMINI_MODEL_FALLBACK_1=
GEMINI_MODEL_FALLBACK_2=
# Tentativas por modelo, entre 1 e 3. Fallback somente para falhas HTTP transitórias.
GEMINI_MAX_ATTEMPTS_PER_MODEL=2
